<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Brand Logo -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/cm"
            android:src="@drawable/cm"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Community Medicine Logo" />

        <!-- Brand Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="COMMUNITY MEDICINE"
            android:textColor="#174D3A"
            android:textSize="23sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:text="INVENTORY MANAGEMENT SYSTEM"
            android:textColor="#779184"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Welcome Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR HEALTHCARE INVENTORY"
                android:textColor="#779184"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Welcome to&#10;Community Medicine."
                android:textColor="#174D3A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="A simple and organized way to monitor medicine supplies, manage inventory, and keep track of stock levels."
                android:textColor="#718078"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <View
                android:layout_width="55dp"
                android:layout_height="4dp"
                android:layout_marginTop="25dp"
                android:background="#83B89B" />

            <Button
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#174D3A"
                android:text="OPEN DASHBOARD  →"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="ORGANIZED SUPPLIES. BETTER COMMUNITY CARE."
            android:textColor="#8A9D91"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>
</ScrollView>
