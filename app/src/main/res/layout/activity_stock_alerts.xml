<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMMUNITY MEDICINE"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INVENTORY MANAGEMENT"
        android:textColor="#777777"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Stock Alerts"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stockAlertDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Medicines that have reached their minimum stock level."
        android:textColor="#777777"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOW STOCK MEDICINES"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stockAlertsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <Button
        android:id="@+id/backToDashboardButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#EAEAEA"
        android:text="BACK TO DASHBOARD"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
