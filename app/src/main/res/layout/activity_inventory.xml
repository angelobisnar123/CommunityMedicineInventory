<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMMUNITY MEDICINE"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INVENTORY MANAGEMENT"
        android:textColor="#777777"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Medicine Inventory"
        android:textColor="#000000"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="View and manage available medicines."
        android:textColor="#777777"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:hint="Search medicine or category"
        android:inputType="text"
        android:padding="14dp"
        android:textColor="#000000" />

    <Button
        android:id="@+id/addMedicineButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#000000"
        android:text="+ ADD MEDICINE"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="MEDICINE RECORDS"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/medicineRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="8dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#EAEAEA"
        android:text="BACK TO DASHBOARD"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>