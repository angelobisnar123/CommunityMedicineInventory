<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#F2F7F4"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/medicineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paracetamol"
        android:textColor="#174D3A"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/medicineSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pain Reliever | Stock: 120 tablets"
        android:textColor="#718078"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:background="#D8E6DD" />

    <TextView
        android:id="@+id/medicineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="Stock available"
        android:textColor="#28734E"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
