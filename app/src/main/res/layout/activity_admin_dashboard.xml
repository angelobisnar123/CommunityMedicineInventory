<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADMIN DASHBOARD"
            android:textColor="#174D3A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adminWelcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Welcome, Administrator"
            android:textColor="#779184"
            android:textSize="14sp" />

        <!-- Staff Management -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STAFF MANAGEMENT"
                android:textColor="#779184"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Create and assign accounts to your staff."
                android:textColor="#718078"
                android:textSize="14sp" />

            <Button
                android:id="@+id/createStaffButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#174D3A"
                android:text="CREATE STAFF ACCOUNT"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/viewStaffButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E4EEE8"
                android:text="VIEW STAFF ACCOUNTS"
                android:textColor="#174D3A"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Inventory -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MEDICINE INVENTORY"
                android:textColor="#779184"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <Button
                android:id="@+id/adminInventoryButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#174D3A"
                android:text="OPEN INVENTORY"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/adminAlertsButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E4EEE8"
                android:text="STOCK &amp; EXPIRATION ALERTS"
                android:textColor="#174D3A"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Logout -->
        <Button
            android:id="@+id/adminLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#B94A48"
            android:text="LOGOUT"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>