<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/cm"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Community Medicine Logo" />

        <!-- Brand -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="COMMUNITY MEDICINE"
            android:textColor="#174D3A"
            android:textSize="23sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="INVENTORY MANAGEMENT SYSTEM"
            android:textColor="#779184"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCOUNT LOGIN"
                android:textColor="#779184"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Welcome back."
                android:textColor="#174D3A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sign in to access the medicine inventory."
                android:textColor="#718078"
                android:textSize="14sp" />

            <!-- Email -->
            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#83B89B"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:padding="14dp"
                android:textColor="#174D3A"
                android:textColorHint="#8A9D91" />

            <!-- Password -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#83B89B"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="#174D3A"
                android:textColorHint="#8A9D91" />

            <!-- Login -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#174D3A"
                android:text="LOGIN  →"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Back -->
            <Button
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E4EEE8"
                android:text="BACK"
                android:textColor="#174D3A"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="SECURE ACCESS • COMMUNITY MEDICINE"
            android:textColor="#8A9D91"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

</ScrollView>